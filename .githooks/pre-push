#!/bin/sh
# A push to main runs what CI fails on fastest: the types, `npm run check` (CLAUDE.md's rules) and the desktop main
# process's launch budget (tools/perf/startup.ts, no build), a few seconds. Skip with `git push --no-verify` only to
# land a fix for main itself.
while read -r _ _ ref _; do [ "$ref" = refs/heads/main ] && main=1; done
[ -n "$main" ] && [ -d node_modules ] || exit 0
npx tsc -b && npm run -s check >/dev/null || { echo "pre-push: main must pass tsc and npm run check (see above)" >&2; exit 1; }
out=$(node tools/perf/startup.ts --main) || { echo "$out" | grep FAIL >&2; echo "pre-push: the desktop main process is over its launch budget (tools/perf/startup.json): import it lazily; raise the limit (same commit) only for growth you meant" >&2; exit 1; }
