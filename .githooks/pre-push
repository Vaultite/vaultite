#!/bin/sh
# A push to main runs what CI fails on fastest: the types, `npm run check` (CLAUDE.md's rules) and the desktop main
# process's launch budget (tools/perf/startup.ts, no build), a few seconds. Meanwhile it asks whether main's CI is red
# and says so, never blocking (tools/mainci.ts). Skip with `git push --no-verify` only to land a fix for main itself.
while read -r _ _ ref _; do [ "$ref" = refs/heads/main ] && main=1; done
[ -n "$main" ] && [ -d node_modules ] || exit 0
said=$(mktemp) || exit 1
node tools/mainci.ts --notice >"$said" 2>/dev/null &
notice() { wait; cat "$said" >&2; rm -f "$said"; }
fail() { echo "$1" >&2; notice; exit 1; }
npx tsc -b && npm run -s check >/dev/null || fail "pre-push: main must pass tsc and npm run check (see above)"
out=$(node tools/perf/startup.ts --main) || { echo "$out" | grep FAIL >&2; fail "pre-push: the desktop main process is over its launch budget (tools/perf/startup.json): import it lazily, or raise the limit in the same commit"; }
notice
