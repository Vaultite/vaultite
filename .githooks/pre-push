#!/bin/sh
# A push to main passes main's gate (tools/maingate.sh). A cloud session doesn't push to main: it lands by a PR GitHub
# squash-merges (tools/land.sh). Skip with `git push --no-verify` only to land a fix for main itself.
while read -r _ sha ref old; do [ "$ref" = refs/heads/main ] && main=1 && to=$sha && from=$old; done
[ -n "$main" ] || exit 0
if [ "$CLAUDE_CODE_REMOTE" = true ]; then
  echo "pre-push: a cloud session lands by PR, not a push to main: tools/land.sh (CLAUDE.md, Working here)" >&2
  exit 1
fi
exec sh tools/maingate.sh "$from" "$to"
