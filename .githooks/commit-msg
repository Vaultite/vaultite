#!/bin/sh
# Conventional Commits only, short subjects: CLAUDE.md "Commits".
# No AI co-author trailers.
grep -iv '^co-authored-by: claude' "$1" > "$1.tmp"; mv "$1.tmp" "$1"
subject=$(grep -v '^#' "$1" | head -n 1)
case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;; esac
types='feat|fix|perf|refactor|docs|test|build|ci|chore|revert'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^ ]"; then
  echo "commit-msg: \"$subject\"" >&2
  echo "  wants type(scope): summary, type: feat fix perf refactor docs test build ci chore revert" >&2
  exit 1
fi
if [ ${#subject} -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} chars, max 72" >&2
  exit 1
fi
