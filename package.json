{
  "name": "vaultite",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "vau": "bin/vau"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "vite",
    "start": "node server.ts",
    "build": "node tools/build.ts",
    "build:demo": "vite build -c vite.demo.config.ts",
    "test": "node tools/test_web.ts && node tools/test_vault.ts && node tools/test_sandbox.ts && node tools/test_setup.ts && node tools/test_selfupdate.ts && node tools/test_stall.ts && node tools/test_desktophost.ts && node tools/test_machines.ts",
    "check": "node tools/check_plugins.ts",
    "smoke": "node web/qa/boot.mjs",
    "qa": "node tools/qa.ts",
    "verify": "node tools/verify.ts",
    "evals": "node tools/evals/run.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "node electron/start.ts",
    "app:build": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_CHANNEL=main node electron/stamp.ts && node tools/build_helpers.ts && electron-builder --dir -c electron/source.cjs",
    "app:build:dev": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_CHANNEL=dev node electron/stamp.ts && node tools/build_helpers.ts && electron-builder --dir -c.appId=app.vaultite.dev -c.productName='Vaultite Dev' -c.extraMetadata.productName='Vaultite Dev'",
    "app:dev": "zsh electron/dev.sh",
    "app:install": "node electron/install.ts",
    "release": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_RELEASE=1 node electron/stamp.ts && node tools/build_helpers.ts && VAULTITE_RELEASE=1 electron-builder --mac --publish never",
    "release:linux": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_RELEASE=1 node electron/stamp.ts && VAULTITE_RELEASE=1 electron-builder --linux --publish never",
    "release:nightly": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_RELEASE=1 VAULTITE_CHANNEL=nightly node electron/stamp.ts && node tools/build_helpers.ts && VAULTITE_RELEASE=1 electron-builder --mac --publish never -c electron/nightly.cjs",
    "release:linux:nightly": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_RELEASE=1 VAULTITE_CHANNEL=nightly node electron/stamp.ts && VAULTITE_RELEASE=1 electron-builder --linux --publish never -c electron/nightly.cjs",
    "release:win": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_RELEASE=1 node electron/stamp.ts && VAULTITE_RELEASE=1 electron-builder --win --publish never",
    "release:win:nightly": "VAULTITE_CLEAN_BUILD=1 npm run build && npm run smoke && VAULTITE_RELEASE=1 VAULTITE_CHANNEL=nightly node electron/stamp.ts && VAULTITE_RELEASE=1 electron-builder --win --publish never -c electron/nightly.cjs",
    "ios": "VAULTITE_CLEAN_BUILD=1 vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@ghostery/adblocker-electron": "^2.20.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@noble/hashes": "^2.4.0",
    "@novnc/novnc": "1.7.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "d3-force": "^3.0.0",
    "defuddle": "^0.19.5",
    "docx-preview": "0.4.1",
    "electron-updater": "^6.8.9",
    "foliate-js": "1.0.1",
    "gemoji": "^8.1.0",
    "ical.js": "^2.2.1",
    "katex": "^0.19.0",
    "kdbxweb": "^2.1.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.48.0",
    "lz-string": "^1.5.0",
    "maplibre-gl": "^6.11.2",
    "marked": "^18.0.14",
    "mermaid": "^12.2.0",
    "node-pty": "1.2.0-beta.15",
    "pele": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.2.14",
    "sonner": "^2.0.8",
    "style-mod": "^4.1.4",
    "tailwindcss": "^4.3.3",
    "tldts-experimental": "^7.4.19",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@electron/fuses": "^1.8.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "buffer": "^6.0.3",
    "builder-util": "^26.15.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "path-browserify": "^1.0.1",
    "playwright-core": "^1.63.0",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.14"
  },
  "main": "electron/main.ts",
  "description": "Vaultite: a personal life dashboard over a vault of Markdown files",
  "homepage": "https://vaultite.com",
  "desktopName": "vaultite.desktop",
  "build": {
    "appId": "app.vaultite.desktop",
    "productName": "Vaultite",
    "directories": {
      "output": "dist-app"
    },
    "asar": false,
    "electronLanguages": ["en", "en-US"],
    "npmRebuild": false,
    "afterPack": "electron/sign.cjs",
    "artifactBuildCompleted": "electron/dmg.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://vaultite.com/updates"
      }
    ],
    "files": [
      "package.json",
      "README.md",
      "screenshots/**",
      "CHANGELOG.md",
      "server.ts",
      "core/**",
      "bundles/**",
      "plugins/**",
      "bin/**",
      "electron/**",
      "examples/vault/**",
      "web/dist/**",
      "web/public/**",
      "web/src/index.css",
      "web/src/shadcn.css",
      "web/src/themes/**",
      "!plugins/**/*.tsx",
      "!electron/mac/**",
      "!**/node_modules/@excalidraw/excalidraw/dist/dev/**",
      "!**/node_modules/mermaid/dist/{mermaid.js,mermaid.min.js,mermaid.esm.mjs,mermaid.esm.min.mjs}",
      "!**/node_modules/mermaid/dist/chunks/{mermaid.esm,mermaid.esm.min}/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.{mts,cts}"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/mac/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "hardenedRuntime": false,
      "fileAssociations": [
        { "ext": ["md", "markdown"], "name": "Markdown", "role": "Editor", "rank": "Default" },
        { "ext": "csv", "name": "CSV table", "role": "Editor", "rank": "Alternate" },
        { "ext": ["html", "htm"], "name": "HTML page", "role": "Editor", "rank": "Alternate" },
        { "ext": "txt", "name": "Plain text", "role": "Editor", "rank": "Alternate" }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Vaultite records audio into your notes when you ask it to, and web pages you allow use the microphone.",
        "NSCameraUsageDescription": "Web pages in Vaultite use the camera when you allow them.",
        "NSLocationUsageDescription": "Web pages in Vaultite know your location when you allow them.",
        "NSLocationWhenInUseUsageDescription": "Web pages in Vaultite know your location when you allow them.",
        "NSAppleEventsUsageDescription": "Scripts in Vaultite's terminals want to control another app.",
        "NSBluetoothAlwaysUsageDescription": "Web pages in Vaultite sign in with a passkey on your phone: Bluetooth tells Vaultite the phone is nearby.",
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown",
            "UTTypeConformsTo": ["public.plain-text"],
            "UTTypeTagSpecification": { "public.filename-extension": ["md", "markdown"], "public.mime-type": ["text/markdown"] }
          }
        ]
      }
    },
    "dmg": {
      "artifactName": "${productName}-${arch}.${ext}",
      "title": "${productName}",
      "background": "electron/mac/dmg-background.png",
      "window": { "width": 660, "height": 400 },
      "iconSize": 128,
      "iconTextSize": 13,
      "contents": [
        { "x": 170, "y": 180, "type": "file" },
        { "x": 490, "y": 180, "type": "link", "path": "/Applications" }
      ],
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "web/public/icon-512.png",
      "executableName": "vaultite",
      "synopsis": "Your notes as plain Markdown files, with your coding agents in them",
      "description": "Vaultite reads a folder of Markdown files (a vault) live: notes, dashboards, logs and plugins, with Claude Code and other agents in its terminals.",
      "maintainer": "Vaultite",
      "desktop": {
        "entry": {
          "StartupWMClass": "vaultite"
        }
      },
      "syncDesktopName": true,
      "fileAssociations": [
        { "ext": ["md", "markdown"], "name": "Markdown", "mimeType": "text/markdown" },
        { "ext": "csv", "name": "CSV table", "mimeType": "text/csv" },
        { "ext": ["html", "htm"], "name": "HTML page", "mimeType": "text/html" },
        { "ext": "txt", "name": "Plain text", "mimeType": "text/plain" }
      ]
    },
    "appImage": {
      "artifactName": "Vaultite-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "vaultite_${version}_${arch}.deb",
      "packageCategory": "editors"
    },
    "win": {
      "target": ["nsis"],
      "icon": "electron/win/icon.ico",
      "fileAssociations": [
        { "ext": ["md", "markdown"], "name": "Vaultite.Markdown", "description": "Markdown" }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Vaultite-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "electron/win/installer.nsh"
    },
    "protocols": [
      {
        "name": "Vaultite",
        "schemes": ["vaultite"]
      },
      {
        "name": "Web page",
        "schemes": ["http", "https"],
        "role": "Viewer"
      }
    ],
    "toolsets": {
      "appimage": "1.0.3"
    }
  },
  "allowScripts": {
    "electron-winstaller": true,
    "fsevents": true,
    "node-pty": true
  },
  "overrides": {
    "kdbxweb": { "@xmldom/xmldom": "^0.8.15" },
    "lodash-es": "^4.18.1"
  }
}
