{
  "manifest_version": 3,
  "name": "Page painter",
  "version": "1.0.0",
  "description": "A made-up extension for web/qa/extensions.mjs: a content script, storage, messaging, a popup and an options page.",
  "key": "",
  "icons": {
    "48": "icon.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Page painter",
    "default_icon": {
      "48": "icon.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.css"
      ],
      "matches": [
        "http://127.0.0.1/*"
      ]
    }
  ]
}
