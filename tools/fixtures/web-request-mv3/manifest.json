{
  "manifest_version": 3,
  "name": "Request watcher",
  "version": "1.0.0",
  "description": "A made-up extension for web/qa/webrequest.mjs: chrome.webRequest observers in a service worker (Manifest V3), and HTTP sign-in as a password manager answers it.",
  "key": "",
  "permissions": ["webRequest", "webRequestAuthProvider"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js" }
}
